{
  "dictionary_name": "Evenki-Russian Dictionary",
  "markers": [
    {
      "marker": "lx",
      "description": "Lexeme / headword (Evenki)"
    },
    {
      "marker": "hm",
      "description": "Homonym number (Roman numerals I, II)"
    },
    {
      "marker": "sn",
      "description": "Sense number (Arabic numerals 1), 2) or 1., 2.)"
    },
    {
      "marker": "gn",
      "description": "Gloss / short translation (Russian)"
    },
    {
      "marker": "un",
      "description": "Usage note (National - Russian parenthetical context e.g., о костях)"
    },
    {
      "marker": "pd",
      "description": "Paradigm / Inflectional form (e.g., 3rd person verb forms in parentheses)"
    },
    {
      "marker": "xv",
      "description": "Example sentence or phrase (Evenki)"
    },
    {
      "marker": "xn",
      "description": "Example translation (Russian)"
    },
    {
      "marker": "lt",
      "description": "Literal meaning (букв.)"
    },
    {
      "marker": "lf",
      "description": "Lexical function line (e.g. Antonym = …; противоп.)"
    },
    {
      "marker": "ln",
      "description": "Translation (Russian) for the word listed in lexical function (antonyms, synonyms)"
    },
    {
      "marker": "cf",
      "description": "Cross-reference to related entries ('Ср.' and 'см.')"
    },
    {
      "marker": "dl",
      "description": "Dialects that have the same word (often appear right after the headword)"
    },
    {
      "marker": "et",
      "description": "Similar words in related languages"
    },
    
    {
      "marker": "eg",
      "description": "Translation (Russian) for the word listed in \\et"
    }
    
  ],
  "rules": [
    "Homograph entries: Use a separate \\lx record for each word with the same spelling but different Roman numerals, adding \\hm I, \\hm II.",
    "Multiple senses: Group each meaning under the same \\lx using \\sn 1), \\sn 2) followed by \\gn for the Russian translation.",
    "Examples: Follow the gloss (\\gn) with \\xv for the Evenki text and \\xn for the Russian translation.",
    "Redirect entries: For minor entries that just say 'см. [word]', use \\lx for the headword and \\mn for the target word.",
    "Grammatical forms: Place 3rd person verb forms given in parentheses right after the headword into \\pd.",
    "Dialects: List them all under \\dl",
    "Cognates: List each language name in square brackets followed by a word form. Put them under \\et, put the gloss under a separate \\eg field"
  ],
